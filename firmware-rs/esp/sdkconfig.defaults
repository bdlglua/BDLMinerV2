# Rust threads (mining, pool, HTTP) need larger stacks than the IDF default.
CONFIG_ESP_MAIN_TASK_STACK_SIZE=16384
CONFIG_PTHREAD_TASK_STACK_SIZE_DEFAULT=8192
CONFIG_ESP_SYSTEM_EVENT_TASK_STACK_SIZE=4096
# All the request's header lines share this buffer: a browser's (User-Agent,
# Accept, Accept-Language, sec-ch-ua, Sec-Fetch-...) exceed 1 KB, and the
# server then dropped the connection (ERR_CONNECTION_RESET) while curl worked.
CONFIG_HTTPD_MAX_REQ_HDR_LEN=4096
CONFIG_HTTPD_MAX_URI_LEN=512
# The partition table (two 1.9 MB app slots, NVS at 0x9000 like the C++
# firmware, so its settings and statistics are kept) is given to espflash.
CONFIG_ESPTOOLPY_FLASHSIZE_4MB=y
CONFIG_COMPILER_OPTIMIZATION_SIZE=y
CONFIG_BT_ENABLED=n
CONFIG_ESP_TASK_WDT_TIMEOUT_S=10
# The mining threads own the second core; the watchdog does not watch its idle task.
CONFIG_ESP_TASK_WDT_CHECK_IDLE_TASK_CPU1=n
CONFIG_FREERTOS_HZ=1000
CONFIG_LWIP_SO_RCVBUF=y
# The bootloader (the image's, built from this file) does not check the app
# image at power-on: it starts it about 0.6 s sooner, and the M5StickC Plus2,
# which turns itself off unless GPIO4 goes high soon after the power button
# or the USB cable wakes it, holds its power in time. Other resets (software,
# watchdog, after an update) still check it.
CONFIG_BOOTLOADER_SKIP_VALIDATE_ON_POWER_ON=y
# 240 MHz like the C++ firmware (board_build.f_cpu): the CPU feeds the SHA
# peripheral, and at ESP-IDF's default 160 MHz an M5StickC Plus2 hashed
# about 0.67 MH/s instead of the C++ firmware's 1.0. The ESP32-C3 has no
# 240 MHz setting and keeps its 160.
CONFIG_ESP_DEFAULT_CPU_FREQ_MHZ_240=y
# Firmware updates: a new firmware boots on trial and the bootloader returns
# to the previous one unless it is confirmed (esp/src/ota.rs).
CONFIG_BOOTLOADER_APP_ROLLBACK_ENABLE=y
# Crash reports: a core dump in the coredump partition at a crash or panic,
# summarised at the next boot and offered at /api/coredump (esp/src/crash.rs).
CONFIG_ESP_COREDUMP_ENABLE_TO_FLASH=y
CONFIG_ESP_COREDUMP_DATA_FORMAT_ELF=y
CONFIG_ESP_COREDUMP_CHECKSUM_CRC32=y
# The dashboard's server (8 sockets, two of them live dashboards), the pool,
# MQTT and the HTTPS requests, at once.
CONFIG_LWIP_MAX_SOCKETS=16
